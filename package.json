{
  "name": "leerboxeditor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone LeerboxEditor met unit- en Playwright-integratietests.",
  "scripts": {
    "test:node": "node --test tests/*.test.mjs",
    "test:python": "python -m unittest discover tests",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:update-baselines": "node tests/visual/update-baselines.mjs",
    "test": "npm run test:node && npm run test:python && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
